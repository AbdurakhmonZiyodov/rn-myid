{
  "name": "rn-myid",
  "version": "1.0.2",
  "description": "React Native wrapper for MyID (uz.myid) — Promise-based TurboModule for the 5–8 internal apps.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "scripts",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\" \"docs/**/*.md\" \"*.md\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\" \"docs/**/*.md\" \"*.md\"",
    "prepare": "bob build && husky",
    "postinstall": "node ./scripts/postinstall-check.js || true",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "myid",
    "identification",
    "uz.myid"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdurakhmonZiyodov/rn-myid.git"
  },
  "author": "AbdurakhmonZiyodov",
  "license": "UNLICENSED",
  "private": false,
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.80.3",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "react": "18.3.1",
    "react-native": "0.80.3",
    "react-native-builder-bob": "^0.32.0",
    "release-it": "^17.0.0",
    "typescript": "^5.3.0"
  },
  "codegenConfig": {
    "name": "RNMyIdSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.rnmyid"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "yarn typecheck",
        "yarn lint"
      ],
      "after:bump": [
        "yarn prepare",
        "node ./scripts/update-readme-version.js"
      ]
    },
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": true,
      "addUntrackedFiles": true,
      "push": true
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    }
  }
}
