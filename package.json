{
  "name": "rn-myid",
  "version": "1.0.0",
  "description": "React Native wrapper for MyID (uz.myid) — Promise-based TurboModule for the 5–8 internal apps.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "scripts",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepare": "bob build",
    "postinstall": "node ./scripts/postinstall-check.js || true"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "myid",
    "identification",
    "uz.myid"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdurakhmonZiyodov/rn-myid.git"
  },
  "author": "AbdurakhmonZiyodov",
  "license": "UNLICENSED",
  "private": false,
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "18.3.1",
    "react-native": "0.80.3",
    "react-native-builder-bob": "^0.32.0",
    "typescript": "^5.3.0"
  },
  "codegenConfig": {
    "name": "RNMyIdSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.rnmyid"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
